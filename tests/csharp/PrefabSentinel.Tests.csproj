    </Compile>
    <Compile Include="..\..\tools\unity\PrefabSentinel.RunScriptCompile.Redaction.cs">
      <Link>Bridge\PrefabSentinel.RunScriptCompile.Redaction.cs</Link>
    </Compile>
    <Compile Include="..\..\tools\unity\PrefabSentinel.RunScript.ResultChannels.cs">
