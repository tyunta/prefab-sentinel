    </Compile>
    <Compile Include="..\..\tools\unity\PrefabSentinel.Properties.SuggestionRanker.cs">
      <Link>Bridge\PrefabSentinel.Properties.SuggestionRanker.cs</Link>
    </Compile>
    <Compile Include="..\..\tools\unity\PrefabSentinel.Properties.InputValidators.cs">
      <Link>Bridge\PrefabSentinel.Properties.InputValidators.cs</Link>
    </Compile>
    <Compile Include="..\..\tools\unity\PrefabSentinel.Properties.PropertyValueParser.cs">
